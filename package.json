{
  "name": "quilly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quilly \u2013 transcripts for Google Meet. Records captions locally, exports them, and lets you iterate on them with AI via OpenRouter.",
  "license": "MIT",
  "author": "Gegham Khachatryan",
  "repository": {
    "type": "git",
    "url": "https://github.com/gegham-khachatryan/quilly"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build --config vite.content.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "store-assets": "node scripts/make-store-assets.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "sync-version": "node scripts/sync-version.mjs",
    "version": "npm run sync-version && git add public/manifest.json",
    "package": "node scripts/package.mjs",
    "release": "npm run check && npm run package"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

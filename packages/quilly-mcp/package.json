{
  "name": "quilly-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets local AI agents list, search and read Google Meet transcripts recorded by the Quilly Chrome extension, including the one being recorded.",
  "license": "MIT",
  "author": "Gegham Khachatryan",
  "repository": {
    "type": "git",
    "url": "https://github.com/gegham-khachatryan/quilly",
    "directory": "packages/quilly-mcp"
  },
  "homepage": "https://github.com/gegham-khachatryan/quilly/tree/main/packages/quilly-mcp#readme",
  "keywords": ["mcp", "model-context-protocol", "google-meet", "transcript", "claude-code", "quilly"],
  "type": "module",
  "bin": {
    "quilly-mcp": "dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
